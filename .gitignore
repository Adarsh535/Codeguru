# Dependencies
node_modules/
**/node_modules/

# Environment files (Secrets Protection: local .env and .env.local are ignored, while template and production configs are tracked)
.env
.env.*
!.env.example
!.env.production
**/.env
**/.env.*
!**/.env.example
!**/.env.production

# Production Build Outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.vite/
**/.vite/

# Uploaded media files
backend/uploads/*
!backend/uploads/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
