# Dependencies
node_modules/
**/node_modules/

# Environment files (Security Protection - secrets should not be committed)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Production Build Outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.vite/
**/.vite/

# Uploaded media files
backend/uploads/*
!backend/uploads/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
