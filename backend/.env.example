# ==========================================
# CODEGURU BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# MongoDB Database Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/codeguru_db
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@<cluster-url>/codeguru_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeguru_db

# Security JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Environment Mode
NODE_ENV=development

# Cloudinary Image/Video Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
