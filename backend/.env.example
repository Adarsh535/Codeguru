# ==========================================
# CODEGURU BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/codeguru_db

# MongoDB Atlas Cloud Connection String:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/codeguru_db?retryWrites=true&w=majority

# Security JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Image & Video Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
