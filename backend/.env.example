# ============================================================================
# CODEGURU BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit the real .env file with actual credentials to Git!
# ============================================================================

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DIRECT_URI=your_direct_replicaset_uri_if_needed

# JWT Authentication Secret Key (Generate with: openssl rand -base64 48)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Application API Security Key (Passed in x-api-key header)
API_SECRET_KEY=your_api_secret_key_here

# Cloudinary Cloud Storage Credentials (For Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client App URLs & CORS Whitelist (Required for production / Render dashboard)
# Comma-separated list of allowed domains that can call the backend API
CORS_ORIGINS=https://codegurru.in,https://www.codegurru.in,https://369.codegurru.in
FRONTEND_URL=https://codegurru.in
ADMIN_URL=https://admin.codegurru.in

# SMS & OTP Gateway Credentials (Twilio / Indian SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Fast2SMS or 2Factor API Keys (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key
TWOFACTOR_API_KEY=your_twofactor_api_key
